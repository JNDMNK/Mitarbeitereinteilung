# Port, auf dem der Container lauscht
PORT=3000
# SQLite-Datei (im Container unter /data). Für PostgreSQL: provider im Schema ändern.
DATABASE_URL=file:/data/einteilung.db
# Langer Zufallswert, z. B.: openssl rand -base64 48
SESSION_SECRET=bitte-aendern-mindestens-32-zeichen-langer-zufallswert
# Öffentliche Adresse der App (wie im Browser), wichtig für CSRF-Prüfung und Cookies
APP_URL=https://einteilung.example.de
# Nur beim allerersten Start verwendet, wenn noch kein Benutzer existiert
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=bitte-aendern-123
# X-Forwarded-For / X-Forwarded-Proto vom Reverse Proxy vertrauen (1 = ja)
TRUST_PROXY=1
TZ=Europe/Berlin
